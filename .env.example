# ===== 场景5: 静态站点全球加速（GitHub Pages + Cloudflare Pages + Neon） =====
# 复制为 .env 后填入实际值。这些变量只在本地开发/构建时用到。
# CI 中通过 GitHub Secrets 注入：DATABASE_URL / CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN / REDIS_*

# 运行时由 Cloudflare Pages 项目环境变量提供（production 与 preview 都要配）

# Neon 数据库连接串（pooled 方式）。注意：不要提交真实密码到仓库！
DATABASE_URL=

# 可选：Redis（缓存热词/计数用，本仓库 /api/cache 演示）
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Cloudflare（本仓库页面由两块组成：GitHub Pages(静态) + Cloudflare Pages(Functions)）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 若 GitHub Pages 部署在子路径需要 basePath，否则留空
NEXT_PUBLIC_BASE_PATH=

# ===== R2 边缘资源池（可选，需先在 Cloudflare Dashboard 开启 R2 服务） =====
# GitHub Actions 会用这些 Secrets 建桶/上传；页面端 Function 通过 env.R2_STORE 读取。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=guide-assets